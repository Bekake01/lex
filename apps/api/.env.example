# Copy to .env for local development. Never commit real values.

NODE_ENV=development
PORT=5000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
SIGN_APP_URL=http://localhost:3001

# Postgres from the root docker-compose.yml (pnpm db:up)
DATABASE_URL=postgres://lex:lex@localhost:5434/lex
# Redis for BullMQ, same docker-compose (pnpm redis:up)
REDIS_URL=redis://localhost:6391

# Signs login access tokens, 32+ characters. Make one: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- AI (OpenAI) ------------------------------------------------------------
# Without a key the AI jobs fail fast and the review is marked failed.
OPENAI_API_KEY=
# Any OpenAI reasoning model with structured outputs (gpt-5, gpt-5-mini, ...)
AI_MODEL=gpt-5
# The simple calls (classify, recipient summaries). Same value as AI_MODEL
# turns the split off; classify reads the whole document, so this is the
# biggest cost lever.
AI_MODEL_LIGHT=gpt-5-mini
# Reasoning effort: low | medium | high | xhigh | max (not every model takes xhigh/max)
AI_EFFORT=high
# Bump when a prompt changes; existing reviews keep their version.
AI_PROMPT_VERSION=v1

# --- Law --------------------------------------------------------------------
# auto (law tables when loaded, else fixtures) | db | fake
LAW_SEARCH_MODE=auto
# Embeddings for law search: Voyage voyage-3.5 (decided in Phase 7). bge-m3 is the self-hosted fallback.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
# EMBEDDING_URL=http://localhost:8080
# Daily lex.uz sync (Phase 14)
SYNC_ENABLED=false

# --- Storage ----------------------------------------------------------------
# local = disk under STORAGE_DIR (default); r2 = Cloudflare R2 (needs the four S3_* keys below)
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
# R2 endpoint without bucket or path: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# R2 uses "auto"
S3_REGION=auto
# Private bucket (ours: lexdoc); bytes always go through the API
S3_BUCKET=
# R2 API token (Object Read & Write on the bucket)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=20971520

# --- Plan limits ------------------------------------------------------------
# 0 = unlimited
AI_REVIEWS_LIMIT_PERSONAL=20
AI_REVIEWS_LIMIT_AGENCY=200
# How long the invite waits for recipient summaries before sending without them.
SUMMARY_WAIT_MS=60000
