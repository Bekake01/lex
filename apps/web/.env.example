# The api, called from the Next.js server (src/lib/api.ts)
API_URL=http://localhost:5000
# The api, called from the browser (login, refresh, apiFetch). Defaults to http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Local only: sign in without the API/database (any email + password). Never set in production.
# NEXT_PUBLIC_DEMO_LOGIN=1
