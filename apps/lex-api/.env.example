# Copy to .env for local development. Never commit real values.

NODE_ENV=development
PORT=5001
LOG_LEVEL=info

# Shared secret the caller (adss-saas apps/api) sends as `x-lex-api-key`.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LEX_API_KEY=

# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgres://lex:lex@localhost:5433/lex

# Embeddings (Phase 7 decides): voyage | bge-m3
EMBEDDING_PROVIDER=voyage
# VOYAGE_API_KEY=
# EMBEDDING_URL=http://localhost:8080

# Daily lex.uz sync (Phase 14)
SYNC_ENABLED=false
